/* 我的订单 */
.filter {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx;
}
.fbtn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #7b8296;
  background: #fff;
  border-radius: 12rpx;
}
.fbtn.active {
  color: #fff;
  background: #ff6a0e;
  font-weight: 600;
}

.olist { padding: 0 24rpx; }
.oitem { padding: 24rpx; margin-bottom: 20rpx; }
.orow { display: flex; align-items: center; justify-content: space-between; }
.oname { font-size: 30rpx; font-weight: 600; }
.otag { font-size: 22rpx; font-weight: 600; }
.osub { font-size: 24rpx; color: #7b8296; margin: 12rpx 0; }
.omuted { font-size: 22rpx; color: #9aa4bd; }
.oprice { font-size: 30rpx; font-weight: 700; color: #ea580c; }

.empty { padding: 100rpx 0; text-align: center; color: #9aa4bd; font-size: 26rpx; }

/* 详情弹窗 */
.d-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, .55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.d-pop {
  width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
}
.d-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.d-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  font-size: 25rpx;
  border-bottom: 1rpx solid #f4f5f9;
}
.dk { color: #9aa4bd; flex-shrink: 0; }
.dv { color: #1f2430; text-align: right; word-break: break-all; }
.dv.strong { font-weight: 700; color: #ea580c; }
.d-notice { text-align: center; font-size: 24rpx; color: #e5484d; margin-top: 20rpx; padding: 16rpx; background: rgba(229,72,77,.06); border-radius: 12rpx; }
.d-btn {
  margin-top: 28rpx;
  text-align: center;
  padding: 16rpx 0;
  background: #ff6a0e;
  color: #fff;
  border-radius: 999rpx;
  font-size: 27rpx;
}
.d-close {
  margin-top: 16rpx;
  text-align: center;
  padding: 12rpx 0;
  color: #7b8296;
  font-size: 25rpx;
}
