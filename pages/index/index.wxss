/* 首页样式 */
.banner-img {
  width: 100%;
  display: block;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

/* 客服悬浮按钮 */
.kf-fab {
  position: fixed;
  right: 24rpx;
  bottom: 180rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #ff6a0e;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 106, 14, .4);
  z-index: 90;
}
.kf-fab-txt { font-size: 18rpx; line-height: 1; margin-top: 2rpx; }

/* 客服弹窗 */
.kf-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, .55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.kf-pop {
  width: 520rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
}
.kf-title { font-size: 30rpx; font-weight: 700; margin-bottom: 28rpx; }
.kf-qr {
  width: 360rpx;
  border: 2rpx solid #f0f2f7;
  border-radius: 16rpx;
}
.kf-tip { font-size: 22rpx; color: #7b8296; margin: 20rpx 0 28rpx; }
.kf-close {
  display: inline-block;
  padding: 12rpx 60rpx;
  background: #ff6a0e;
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
}

/* 点单须知弹窗 */
.notice-mask {
  position: fixed; inset: 0; z-index: 999;
  background: rgba(0, 0, 0, .55);
  display: flex; align-items: center; justify-content: center;
}
.notice-pop {
  width: 620rpx; max-height: 78vh;
  background: var(--card); border-radius: 28rpx;
  padding: 40rpx 36rpx 28rpx;
  display: flex; flex-direction: column; overflow: hidden;
}
.notice-title { font-size: 32rpx; font-weight: 800; text-align: center; color: var(--text); margin-bottom: 24rpx; }
.notice-body { max-height: 52vh; }
.notice-item { font-size: 26rpx; color: var(--text); line-height: 1.9; margin-bottom: 6rpx; }
.notice-close { margin-top: 24rpx; text-align: center; padding: 18rpx 0; background: var(--primary); color: #fff; border-radius: 999rpx; font-size: 29rpx; font-weight: 600; }

/* 今日运势弹窗 */
.fortune-pop {
  width: 520rpx;
  background: linear-gradient(160deg, #fff8f0, #ffe8d2);
  border-radius: 24rpx;
  padding: 48rpx 36rpx 36rpx;
  text-align: center;
}
.fortune-level { font-size: 52rpx; font-weight: 800; color: #ea580c; }
.fortune-text { font-size: 28rpx; color: #1f2430; margin: 24rpx 0 32rpx; line-height: 1.6; }
.fortune-used { font-size: 26rpx; color: #7b8296; margin: 32rpx 0; }
