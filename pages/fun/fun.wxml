<view class="page {{theme}}">
  <view class="scroll">

    <view class="announce">
      <view class="ico">趣味单</view>
      <view class="txt">明码标价 · 保底到手 · 全程担保，玩法有疑问先问客服</view>
    </view>

    <block wx:if="{{groups.length}}">
      <!-- 分区 tab -->
      <view class="fz-tabs">
        <view wx:for="{{groups}}" wx:key="category" wx:for-item="g" wx:for-index="i"
              class="fz-tab {{funSel == i ? 'on' : ''}}"
              bindtap="setFunSel" data-i="{{i}}">{{g.category}}</view>
      </view>

      <!-- 网格 2 列 -->
      <view class="fgrid">
        <view class="fcard2" wx:for="{{groups[funSel].items}}" wx:for-item="item" wx:key="id"
              bindtap="openOrder" data-id="{{item.id}}">
          <image class="fimg" src="{{item.image}}" mode="aspectFill" />
          <view class="fbody">
            <view class="fnm">{{item.name}}
              <text class="tag tag-orange" wx:if="{{item.tags.length}}" style="margin-left:8rpx">{{item.tags[0]}}</text>
            </view>
            <view class="fsub2">{{item.sub}}</view>
            <view class="frow2">
              <view class="fprice">¥{{item.price}}<text class="sm">/单</text></view>
              <view class="btn mini-btn">下单</view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view style="padding:40rpx 0;text-align:center" class="muted">— 已到底 · 更多趣味单持续上新 —</view>

  </view>

  <!-- 下单弹窗（不变） -->
  <view class="mask {{showOrder ? 'show' : ''}}" bindtap="closeOrder">
    <view class="sheet" catchtap="noop">
      <view class="bar"></view>
      <view class="sh-title" wx:if="{{cur}}">🛒 {{cur.name}}</view>

      <view class="ofield" wx:if="{{cur}}">
        <view class="muted sm" wx:if="{{cur.buy_limit}}" style="margin-bottom:16rpx">⚠️ {{cur.buy_limit === 'weekly' ? '该玩法每周限购 1 次' : '该玩法每人限购 1 次'}}</view>
        <view class="lab">购买数量</view>
        <view class="qty">
          <view class="stepper" bindtap="qtyMinus">−</view>
          <view class="qnum">{{qty}}</view>
          <view class="stepper {{cur.buy_limit ? 'disabled' : ''}}" bindtap="qtyPlus">＋</view>
          <text class="muted sm" style="margin-left:16rpx">单价 ¥{{cur.price}}</text>
        </view>

        <view class="lab">选择区服</view>
        <view class="opts">
          <view class="opt {{selServer == index ? 'active' : ''}}"
                wx:for="{{servers}}" wx:key="*this"
                data-i="{{index}}" bindtap="setServer">{{item}}</view>
        </view>

        <view class="lab">设备端别</view>
        <view class="opts">
          <view class="opt {{selPlatform == index ? 'active' : ''}}"
                wx:for="{{platforms}}" wx:key="*this"
                data-i="{{index}}" bindtap="setPlatform">{{item}}</view>
        </view>

        <view class="lab">订单信息</view>
        <view class="finp-row">
          <input class="inp" placeholder="游戏ID（必填）" maxlength="32" value="{{gameId}}" bindinput="onGameId" />
        </view>
        <view class="finp-row">
          <input class="inp" placeholder="微信号（接单联系）" maxlength="32" value="{{gameWx}}" bindinput="onWx" />
        </view>
        <textarea class="ta" placeholder="备注（选填）" value="{{note}}" bindinput="onNote"></textarea>

        <view class="frow" style="margin-top:20rpx">
          <view class="total">合计 <text class="tp">¥{{total}}</text></view>
          <view class="btn" bindtap="confirmOrder">确认下单</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 支付弹窗 -->
  <view class="mask {{showPay ? 'show' : ''}}" data-m="pay" bindtap="onMask">
    <view class="sheet" catchtap="noop">
      <view class="bar"></view>
      <view class="sh-title">💰 确认支付 <text class="hl2">¥{{payAmount}}</text></view>

      <view class="pay-opt {{payMethod == '微信支付' ? 'active' : ''}}" bindtap="pickPay" data-m="微信支付">
        <view class="ic" style="background:#22c55e">💚</view>
        <view><view class="pn">微信支付</view><view class="muted sm">推荐 · 到账快</view></view>
        <view class="rr">{{payMethod == '微信支付' ? '✓' : ''}}</view>
      </view>

      <view class="pay-opt {{payMethod == '余额支付' ? 'active' : ''}}" bindtap="pickPay" data-m="余额支付">
        <view class="ic" style="background:linear-gradient(135deg,#ff8a2a,#ff6a0e)">🪙</view>
        <view><view class="pn">余额支付</view><view class="muted sm">余额 ¥{{balance}}</view></view>
        <view class="rr">{{payMethod == '余额支付' ? '✓' : ''}}</view>
      </view>

      <view class="btn block" bindtap="doPay">立即支付</view>
      <view class="agree">支付即代表同意《护航服务协议》· 全程担保交易</view>
    </view>
  </view>

  <!-- 下单成功弹窗 -->
  <view class="mask mid {{showOk ? 'show' : ''}}" bindtap="hideOk">
    <view class="ok-modal" catchtap="noop">
      <view class="c">✓</view>
      <view class="ok-h">下单成功</view>
      <view class="ok-p">已支付 <text class="hl2">¥{{payAmount}}</text>（{{payMethod}}）</view>
      <view class="ok-p" wx:if="{{cur}}">「{{cur.name}}」× {{qty}} 份，客服将尽快联系发放</view>
      <view class="ok-p">全程担保交易，发货异常随时可退款</view>
      <view class="ok-btns">
        <view class="btn ghost" bindtap="hideOk">知道了</view>
        <view class="btn" bindtap="backHome">返回首页</view>
      </view>
    </view>
  </view>
</view>
