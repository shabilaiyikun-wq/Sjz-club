<view class="page">
  <view class="scroll">

    <view class="me-head">
      <view class="av"><view class="avc avc2">{{initial}}</view></view>
      <view>
        <view class="nm">{{nickname}}</view>
        <view class="lv">🔰 护航老客户 · 全程担保交易</view>
      </view>
      <view class="stats">
        <view><text class="num">{{balance}}</text><text class="cap">余额</text></view>
        <view><text class="num">36</text><text class="cap">优惠券</text></view>
        <view><text class="num">6</text><text class="cap">积分</text></view>
      </view>
    </view>

    <view class="orders">
      <view class="o" wx:for="{{orders}}" wx:key="t"
            bindtap="tap" data-t="{{item.t}}：{{item.v}} 单">
        <text style="color:{{item.c}}" class="num">{{item.v}}</text>{{item.t}}
      </view>
    </view>

    <view class="mlist">
      <view class="mitem" wx:for="{{menu}}" wx:key="t"
            bindtap="tap" data-t="{{item.toast}}">
        <view class="ic {{item.ic}}">{{item.icon}}</view>
        {{item.t}}
        <view class="arr">›</view>
      </view>
    </view>

  </view>
</view>
