/* 顶部余额卡片 */
.whead {
  margin: 24rpx;
  padding: 40rpx 36rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(120% 220% at 0% 0%, rgba(255,255,255,.20), transparent 55%),
    linear-gradient(135deg, #ff8a2a, #ff4d00);
  color: #fff;
}
.whead .wlabel { font-size: 24rpx; opacity: .92; }
.whead .wbal { display: block; font-size: 64rpx; font-weight: 800; margin-top: 10rpx; }
.whead .wsym { font-size: 32rpx; margin-right: 8rpx; }
.whead .wre {
  margin-top: 24rpx; width: 200rpx; text-align: center; padding: 16rpx 0;
  border-radius: 999rpx; background: rgba(0,0,0,.18); font-size: 26rpx; font-weight: 600;
}

/* 流水列表 */
.tlist {
  margin: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  overflow: hidden;
}
.titem {
  display: flex; align-items: center; gap: 20rpx;
  padding: 26rpx 28rpx; font-size: 26rpx; color: var(--text);
  border-bottom: 1rpx solid var(--line);
}
.titem:last-child { border-bottom: none; }
.tic {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex: none;
  background: var(--soft); display: flex; align-items: center; justify-content: center; font-size: 30rpx;
}
.tmid { flex: 1; min-width: 0; }
.tnm { font-weight: 600; }
.tsub { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.tval { font-size: 30rpx; font-weight: 700; }
.tval.plus { color: #2fd68b; }
.tval.minus { color: #ff4d5e; }
.tempty { text-align: center; padding: 80rpx 0; font-size: 24rpx; color: var(--muted); }
