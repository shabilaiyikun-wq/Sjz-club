/* ===== 全局（亮色主题） ===== */
page {
  background: #f2f4f8;
  color: #1f2430;
  font-family: "PingFang SC", "Microsoft YaHei", -apple-system, sans-serif;
  height: 100%;
}
view, text, scroll-view, input, textarea { box-sizing: border-box; }

.page { height: 100%; display: flex; flex-direction: column; }
.scroll { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.muted { color: #7b8296; }
.sm { font-size: 22rpx; }
.hl { color: #ff6a0e; }
.hl2 { color: #ea580c; }

.card {
  background: #ffffff;
  border: 1rpx solid #e6e9f0;
  border-radius: 24rpx;
}

/* 标签 / 星级 */
.tag {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.6;
  margin-left: 8rpx;
}
.tag-orange { background: rgba(255,106,14,.10); color: #e2570a; }
.tag-cyan   { background: rgba(46,197,255,.12); color: #0091cc; }
.tag-green  { background: rgba(47,214,139,.14); color: #0f9d6e; }
.stars { color: #ff9f0a; font-size: 22rpx; letter-spacing: 2rpx; }

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 18rpx 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff8a2a, #ff6a0e);
  box-shadow: 0 8rpx 28rpx rgba(255,106,14,.25);
}
.btn:active { transform: scale(.97); }
.btn.block { width: 100%; }
.btn.ghost {
  background: #f6f7fb;
  color: #1f2430;
  box-shadow: none;
  border: 1rpx solid #e6e9f0;
}

/* 头像（首字渐变头像，免图片域名） */
.avc {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; color: #fff; font-weight: 700;
}
.avc0 { background: linear-gradient(135deg, #ff8a2a, #ff4d00); }
.avc1 { background: linear-gradient(135deg, #2ec5ff, #0f7bff); }
.avc2 { background: linear-gradient(135deg, #ffb84d, #ff8a1f); }
.avc3 { background: linear-gradient(135deg, #b48cff, #7c5cff); }

/* ===== 首页 ===== */
.announce {
  display: flex; align-items: center;
  padding: 16rpx 28rpx;
  background: linear-gradient(90deg, rgba(255,106,14,.10), rgba(255,106,14,.03));
  font-size: 24rpx; color: #e2570a;
  white-space: nowrap; overflow: hidden;
}
.announce .ico {
  flex: none; background: #ff6a0e; color: #fff;
  font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 6rpx; margin-right: 16rpx;
}
.announce .txt { overflow: hidden; text-overflow: ellipsis; }

.banner {
  margin: 24rpx 24rpx 0; height: 260rpx; border-radius: 28rpx; overflow: hidden; position: relative;
  background:
    radial-gradient(120% 160% at 85% 0%, rgba(46,197,255,.40), transparent 55%),
    radial-gradient(140% 180% at 0% 100%, rgba(255,122,26,.55), transparent 60%),
    linear-gradient(135deg, #16233f, #0f1830);
  border: 1rpx solid #22304d;
}
.banner .inner {
  position: relative; padding: 36rpx; height: 100%;
  display: flex; flex-direction: column; justify-content: space-between;
}
.banner .logo { font-size: 48rpx; font-weight: 900; letter-spacing: 4rpx; color: #fff; }
.banner .logo .sub {
  display: block; font-size: 22rpx; font-weight: 400;
  color: rgba(255,255,255,.55); letter-spacing: 6rpx; margin-top: 6rpx;
}
.banner .act { display: flex; align-items: center; justify-content: space-between; }
.banner .hot { font-size: 22rpx; color: #ffd9a8; }
.banner .act .btn { font-size: 24rpx; padding: 12rpx 28rpx; }

.wallet {
  margin: 24rpx; padding: 28rpx;
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(135deg, #ffffff, #fff5ec);
  border: 1rpx solid #ffe0c4; border-radius: 28rpx;
}
.wallet .num { font-size: 44rpx; font-weight: 800; color: #ea580c; }
.wallet .num .small { font-size: 22rpx; color: #7b8296; font-weight: 400; }
.wallet .btns { display: flex; }
.wallet .btns .btn { padding: 14rpx 28rpx; font-size: 24rpx; margin-left: 16rpx; }

.grid4 {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin: 24rpx;
}
.cell {
  background: #ffffff; border: 1rpx solid #e6e9f0; border-radius: 24rpx;
  padding: 20rpx 8rpx;
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
}
.cell:active { transform: scale(.96); }
.cell .ic {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx;
}
.cell text { font-size: 22rpx; color: #1f2430; }
.cell .pp { color: #ea580c; font-size: 26rpx; font-weight: 700; }
.ic1 { background: linear-gradient(135deg, #ff8a2a, #ff4d00); }
.ic2 { background: linear-gradient(135deg, #2ec5ff, #0f7bff); }
.ic3 { background: linear-gradient(135deg, #ffb84d, #ff8a1f); }
.ic4 { background: linear-gradient(135deg, #b48cff, #7c5cff); }

.sect { margin: 32rpx 24rpx 0; }
.sect .hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.sect .hd .h { font-size: 30rpx; font-weight: 700; display: flex; align-items: center; }
.sect .hd .h::before {
  content: ""; width: 6rpx; height: 28rpx; border-radius: 4rpx;
  background: #ff6a0e; margin-right: 12rpx;
}
.sect .hd .more { font-size: 22rpx; color: #7b8296; }

.zone {
  background:
    radial-gradient(140% 200% at 100% 0%, rgba(255,150,70,.12), transparent 55%),
    linear-gradient(135deg, #fff7f0, #ffffff);
  border: 1rpx solid #ffe4cf; border-radius: 28rpx; padding: 28rpx; overflow: hidden;
}
.zone .ztitle { font-size: 32rpx; font-weight: 800; letter-spacing: 2rpx; color: #1f2430; }
.zone .zdesc { font-size: 22rpx; color: #7b8296; margin: 8rpx 0 20rpx; }
.zone .zbtns { display: flex; flex-wrap: wrap; }
.zbtn {
  font-size: 22rpx; padding: 10rpx 20rpx; border-radius: 12rpx;
  border: 1rpx solid #e6e9f0; color: #3a4152; background: #ffffff; margin-right: 16rpx;
}
.zbtn.hot { background: rgba(255,106,14,.08); border-color: #ffc9a3; color: #e2570a; }

.booster-scroll { white-space: nowrap; }
.booster-row { display: inline-flex; padding: 8rpx 4rpx 20rpx; }
.booster {
  flex: none; width: 300rpx;
  background: #ffffff; border: 1rpx solid #e6e9f0; border-radius: 28rpx;
  padding: 24rpx; margin-right: 20rpx;
}
.booster:active { transform: scale(.97); }
.booster .av {
  width: 88rpx; height: 88rpx; border-radius: 50%; overflow: hidden;
  border: 4rpx solid #ff6a0e; position: relative;
}
.booster .av .vip {
  position: absolute; bottom: -4rpx; right: -8rpx;
  font-size: 16rpx; background: #ff6a0e; color: #fff; border-radius: 8rpx; padding: 0 6rpx;
}
.booster .nm { font-size: 26rpx; font-weight: 700; margin-top: 16rpx; color: #1f2430; }
.booster .meta { font-size: 22rpx; color: #7b8296; margin-top: 6rpx; }
.booster .price { margin-top: 16rpx; font-size: 28rpx; font-weight: 800; color: #ea580c; }
.booster .price .small { font-size: 20rpx; color: #7b8296; font-weight: 400; }

/* ===== 护航列表 ===== */
.fbtn {
  flex: none; font-size: 24rpx; padding: 12rpx 28rpx; border-radius: 40rpx;
  border: 1rpx solid #e6e9f0; color: #7b8296; background: #ffffff; margin-right: 16rpx;
}
.fbtn.active {
  background: linear-gradient(135deg, #ff8a2a, #ff6a0e);
  color: #fff; border-color: transparent; font-weight: 600;
}
.bcard { display: flex; gap: 24rpx; padding: 28rpx; margin: 24rpx 24rpx 0; }
.bcard:active { transform: scale(.985); }
.bcard .av {
  width: 116rpx; height: 116rpx; border-radius: 50%; overflow: hidden;
  border: 4rpx solid #ff6a0e; flex: none; position: relative;
}
.bcard .av .lv {
  position: absolute; left: 50%; bottom: -6rpx; transform: translateX(-50%);
  background: #ff6a0e; color: #fff; font-size: 18rpx; padding: 0 12rpx; border-radius: 16rpx; white-space: nowrap;
}
.bcard .info { flex: 1; min-width: 0; }
.bcard .nm { display: flex; align-items: center; }
.bcard .nm .bn { font-size: 30rpx; font-weight: 700; color: #1f2430; }
.bcard .row { display: flex; align-items: center; margin-top: 10rpx; flex-wrap: wrap; gap: 12rpx; }
.bcard .row .tag { margin-left: 0; }
.bcard .desc {
  font-size: 22rpx; color: #7b8296; margin-top: 12rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.bcard .rt { text-align: right; flex: none; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; }
.bcard .rt .p { color: #ea580c; font-size: 32rpx; font-weight: 800; }
.bcard .rt .p .small { font-size: 20rpx; color: #7b8296; font-weight: 400; }
.bcard .rt .ord { font-size: 20rpx; color: #7b8296; }

/* ===== 下单详情 ===== */
.spec { margin: 24rpx; padding: 28rpx; }
.spec .lab { font-size: 24rpx; color: #7b8296; margin: 20rpx 0 16rpx; display: flex; align-items: center; }
.spec .lab::before { content: ""; width: 6rpx; height: 20rpx; background: #ff6a0e; border-radius: 4rpx; margin-right: 8rpx; }
.opts { display: flex; flex-wrap: wrap; }
.opt {
  font-size: 24rpx; padding: 14rpx 24rpx; border-radius: 16rpx;
  border: 1rpx solid #e6e9f0; background: #ffffff; color: #1f2430;
  margin: 0 16rpx 16rpx 0; text-align: center;
}
.opt .sub { display: block; font-size: 20rpx; color: #7b8296; margin-top: 2rpx; }
.opt.active { border-color: #ff6a0e; color: #e2570a; background: rgba(255,106,14,.08); font-weight: 600; }
.opt.active .sub { color: #e2570a; }
.field { margin: 24rpx; display: flex; flex-direction: column; }
.field .row { display: flex; }
.field .row .inp {
  flex: 1; height: 88rpx;
  background: #ffffff; border: 1rpx solid #e6e9f0; border-radius: 16rpx;
  padding: 20rpx 24rpx; color: #1f2430; font-size: 26rpx;
}
.field .row .inp + .inp { margin-left: 16rpx; }
.field .ta {
  width: 100%; height: 120rpx; margin-top: 16rpx;
  background: #ffffff; border: 1rpx solid #e6e9f0; border-radius: 16rpx;
  padding: 20rpx 24rpx; color: #1f2430; font-size: 26rpx;
}
.order-bar {
  display: flex; align-items: center; gap: 24rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff; border-top: 1rpx solid #e6e9f0;
}
.order-bar .total { font-size: 22rpx; color: #7b8296; }
.order-bar .total .tp { font-size: 36rpx; color: #ea580c; }
.order-bar .total .tip { font-size: 20rpx; color: #7b8296; margin-top: 2rpx; }
.order-bar .btn { flex: 1; }

/* ===== 排行榜 ===== */
.rank-sel { display: flex; justify-content: center; padding: 24rpx; }
.rank-sel .fbtn { margin: 0 8rpx; }
.rank-list { padding: 0 24rpx; }
.r-item { display: flex; align-items: center; gap: 24rpx; padding: 24rpx; margin-bottom: 16rpx; }
.r-item .no { width: 44rpx; text-align: center; font-weight: 800; font-size: 30rpx; color: #7b8296; }
.r-item .no.n1 { color: #ff9f0a; }
.r-item .no.n2 { color: #9aa4bd; }
.r-item .no.n3 { color: #e08a5c; }
.r-item .av { width: 80rpx; height: 80rpx; border-radius: 50%; overflow: hidden; border: 1rpx solid #e6e9f0; }
.r-item .rmid { flex: 1; }
.r-item .nm { font-size: 26rpx; font-weight: 600; color: #1f2430; }
.r-item .sub { font-size: 22rpx; color: #7b8296; margin-top: 4rpx; }
.r-item .val { text-align: right; }
.r-item .val .vv { color: #ea580c; font-size: 28rpx; font-weight: 700; }

/* ===== 我的 ===== */
.me-head {
  margin: 24rpx; padding: 36rpx;
  display: flex; align-items: center; gap: 28rpx;
  background:
    radial-gradient(120% 180% at 100% 0%, rgba(255,150,70,.14), transparent 55%),
    linear-gradient(135deg, #fff6ee, #ffffff);
  border: 1rpx solid #ffe0c4; border-radius: 32rpx; position: relative; overflow: hidden;
}
.me-head .av { width: 108rpx; height: 108rpx; border-radius: 50%; overflow: hidden; border: 4rpx solid #ff6a0e; }
.me-head .nm { font-size: 34rpx; font-weight: 700; color: #1f2430; }
.me-head .lv { font-size: 22rpx; color: #ea580c; margin-top: 6rpx; }
.me-head .stats { margin-left: auto; display: flex; gap: 36rpx; position: relative; z-index: 1; }
.me-head .stats view { text-align: center; }
.me-head .stats .num { display: block; font-size: 32rpx; color: #ea580c; }
.me-head .stats .cap { font-size: 20rpx; color: #7b8296; }

.orders { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin: 24rpx; }
.orders .o {
  background: #ffffff; border: 1rpx solid #e6e9f0; border-radius: 24rpx;
  padding: 24rpx 8rpx;
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  font-size: 22rpx; color: #7b8296;
}
.orders .o .num { font-size: 36rpx; font-weight: 700; color: #1f2430; }

.mlist { background: #ffffff; border: 1rpx solid #e6e9f0; border-radius: 24rpx; margin: 24rpx; overflow: hidden; }
.mitem {
  display: flex; align-items: center; gap: 20rpx;
  padding: 26rpx 28rpx; font-size: 26rpx; color: #1f2430;
  border-bottom: 1rpx solid #e6e9f0;
}
.mitem:last-child { border-bottom: none; }
.mitem:active { background: #f6f7fb; }
.mitem .ic {
  width: 60rpx; height: 60rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}
.mitem .arr { margin-left: auto; color: #9aa4bd; font-size: 22rpx; }

/* ===== 弹窗 ===== */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(23,26,40,.55); z-index: 100;
  display: none; align-items: flex-end; justify-content: center;
}
.mask.show { display: flex; }
.mask.mid { align-items: center; }
.sheet {
  width: 100%; background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  animation: up .25s ease;
}
@keyframes up { from { transform: translateY(60rpx); opacity: .4; } to { transform: none; opacity: 1; } }
.sheet .bar { width: 72rpx; height: 8rpx; border-radius: 4rpx; background: #e3e7ef; margin: 0 auto 28rpx; }
.sheet .sh-title { font-size: 30rpx; margin-bottom: 24rpx; color: #1f2430; }
.sheet .btn { margin-top: 12rpx; }
.sheet .agree { text-align: center; font-size: 20rpx; color: #7b8296; margin-top: 20rpx; }

.pay-opt {
  display: flex; align-items: center; gap: 20rpx;
  padding: 26rpx; margin-bottom: 16rpx;
  border: 1rpx solid #e6e9f0; border-radius: 20rpx; background: #ffffff;
}
.pay-opt.active { border-color: #2fd68b; background: rgba(47,214,139,.08); }
.pay-opt .ic {
  width: 60rpx; height: 60rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}
.pay-opt .pn { font-size: 26rpx; color: #1f2430; }
.pay-opt .rr { margin-left: auto; color: #2fd68b; font-size: 28rpx; }

.ok-modal {
  width: 80%; background: #ffffff; border-radius: 32rpx;
  padding: 52rpx 40rpx; text-align: center;
  animation: pop .25s ease;
}
@keyframes pop { from { transform: scale(.85); opacity: .4; } to { transform: none; opacity: 1; } }
.ok-modal .c {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: rgba(47,214,139,.15); color: #0f9d6e;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 28rpx; font-size: 60rpx;
}
.ok-modal .ok-h { font-size: 34rpx; margin-bottom: 16rpx; color: #1f2430; }
.ok-modal .ok-p { font-size: 24rpx; color: #7b8296; line-height: 1.8; }
.ok-modal .ok-btns { display: flex; gap: 16rpx; margin-top: 36rpx; }
.ok-modal .ok-btns .btn { flex: 1; padding: 20rpx 0; }
