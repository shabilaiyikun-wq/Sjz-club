/* ===== 主题变量（亮色为默认，暗色由根节点 .page.theme-dark 覆盖） ===== */
page {
  --bg: #f2f4f8;
  --card: #ffffff;
  --text: #1f2430;
  --muted: #7b8296;
  --muted2: #9aa4bd;
  --line: #e6e9f0;
  --soft: #f6f7fb;
  --primary: #ff6a0e;
  --primary-deep: #ea580c;
  --primary-hl: #e2570a;
  --warmA: #fff7f0;
  --warmB: #fff6ee;
  --warmLine: #ffe0c4;
  font-family: "PingFang SC", "Microsoft YaHei", -apple-system, sans-serif;
  height: 100%;
  background: var(--bg);
  color: var(--text);
}
.page.theme-dark {
  --bg: #12151c;
  --card: #1d212b;
  --text: #e9ebf2;
  --muted: #8b93a7;
  --muted2: #5f6879;
  --line: #2a2f3b;
  --soft: #232836;
  --primary: #ff8a3d;
  --primary-deep: #ff9f5a;
  --primary-hl: #ffb27a;
  --warmA: #221a10;
  --warmB: #201a12;
  --warmLine: #3b2c1b;
}
view, text, scroll-view, input, textarea { box-sizing: border-box; }

.page { height: 100%; display: flex; flex-direction: column; background: var(--bg); }
.scroll { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.muted { color: var(--muted); }
.sm { font-size: 22rpx; }
.hl { color: var(--primary); }
.hl2 { color: var(--primary-deep); }

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}

/* 标签 / 星级 */
.tag {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.6;
  margin-left: 8rpx;
}
.tag-orange { background: rgba(255,106,14,.10); color: var(--primary-hl); }
.tag-cyan   { background: rgba(46,197,255,.12); color: #0091cc; }
.tag-green  { background: rgba(47,214,139,.14); color: #0f9d6e; }
.stars { color: #ff9f0a; font-size: 22rpx; letter-spacing: 2rpx; }

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 18rpx 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff8a2a, var(--primary));
  box-shadow: 0 8rpx 28rpx rgba(255,106,14,.25);
}
.btn:active { transform: scale(.97); }
.btn.block { width: 100%; }
.btn.ghost {
  background: var(--soft);
  color: var(--text);
  box-shadow: none;
  border: 1rpx solid var(--line);
}

/* 头像（首字渐变头像，免图片域名） */
.avc {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; color: #fff; font-weight: 700;
}
.av-img { width: 100%; height: 100%; border-radius: 50%; }
.avc0 { background: linear-gradient(135deg, #ff8a2a, #ff4d00); }
.avc1 { background: linear-gradient(135deg, #2ec5ff, #0f7bff); }
.avc2 { background: linear-gradient(135deg, #ffb84d, #ff8a1f); }
.avc3 { background: linear-gradient(135deg, #b48cff, #7c5cff); }

/* ===== 首页 ===== */
.announce {
  display: flex; align-items: center;
  padding: 16rpx 28rpx;
  background: linear-gradient(90deg, rgba(255,106,14,.10), rgba(255,106,14,.03));
  font-size: 24rpx; color: var(--primary-hl);
  white-space: nowrap; overflow: hidden;
}
.announce .ico {
  flex: none; background: var(--primary); color: #fff;
  font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 6rpx; margin-right: 16rpx;
}
.announce .txt { overflow: hidden; text-overflow: ellipsis; }

.banner {
  margin: 24rpx 24rpx 0; height: 260rpx; border-radius: 28rpx; overflow: hidden; position: relative;
  background:
    radial-gradient(120% 160% at 85% 0%, rgba(46,197,255,.40), transparent 55%),
    radial-gradient(140% 180% at 0% 100%, rgba(255,122,26,.55), transparent 60%),
    linear-gradient(135deg, #16233f, #0f1830);
  border: 1rpx solid #22304d;
}
.banner .inner {
  position: relative; padding: 36rpx; height: 100%;
  display: flex; flex-direction: column; justify-content: space-between;
}
.banner .logo { font-size: 48rpx; font-weight: 900; letter-spacing: 4rpx; color: #fff; }
.banner .logo .sub {
  display: block; font-size: 22rpx; font-weight: 400;
  color: rgba(255,255,255,.55); letter-spacing: 6rpx; margin-top: 6rpx;
}
.banner .act { display: flex; align-items: center; justify-content: space-between; }
.banner .hot { font-size: 22rpx; color: #ffd9a8; }
.banner .act .btn { font-size: 24rpx; padding: 12rpx 28rpx; }

.grid4 {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin: 24rpx;
}
.grid3 {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin: 24rpx;
}
.cell {
  background: var(--card); border: 1rpx solid var(--line); border-radius: 24rpx;
  padding: 20rpx 8rpx;
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
}
.cell:active { transform: scale(.96); }
.cell .ic {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx;
}
.cell text { font-size: 22rpx; color: var(--text); }
.cell .pp { color: var(--primary-deep); font-size: 26rpx; font-weight: 700; }
.ic1 { background: linear-gradient(135deg, #ff8a2a, #ff4d00); }
.ic2 { background: linear-gradient(135deg, #2ec5ff, #0f7bff); }
.ic3 { background: linear-gradient(135deg, #ffb84d, #ff8a1f); }
.ic4 { background: linear-gradient(135deg, #b48cff, #7c5cff); }

.sect { margin: 32rpx 24rpx 0; }
.sect .hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.sect .hd .h { font-size: 30rpx; font-weight: 700; display: flex; align-items: center; }
.sect .hd .h::before {
  content: ""; width: 6rpx; height: 28rpx; border-radius: 4rpx;
  background: var(--primary); margin-right: 12rpx;
}
.sect .hd .more { font-size: 22rpx; color: var(--muted); }

.zone {
  background:
    radial-gradient(140% 200% at 100% 0%, rgba(255,150,70,.12), transparent 55%),
    linear-gradient(135deg, var(--warmA), var(--card));
  border: 1rpx solid var(--warmLine); border-radius: 28rpx; padding: 28rpx; overflow: hidden;
}
.zone .ztitle { font-size: 32rpx; font-weight: 800; letter-spacing: 2rpx; color: var(--text); }
.zone .zdesc { font-size: 22rpx; color: var(--muted); margin: 8rpx 0 20rpx; }
.zone .zbtns { display: flex; flex-wrap: wrap; }
.zbtn {
  font-size: 22rpx; padding: 10rpx 20rpx; border-radius: 12rpx;
  border: 1rpx solid var(--line); color: var(--text); background: var(--card); margin-right: 16rpx;
}
.zbtn.hot { background: rgba(255,106,14,.08); border-color: #ffc9a3; color: var(--primary-hl); }

/* 趣味单分区 tab 选择样式（首页专区 + 趣味单页共用） */
.fz-tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.fz-tab {
  flex: 1; text-align: center; padding: 14rpx 0; font-size: 24rpx;
  color: var(--muted); background: var(--card); border: 1rpx solid var(--line); border-radius: 999rpx;
}
.fz-tab.on { color: #fff; background: var(--primary); border-color: var(--primary); font-weight: 700; }
.fz-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14rpx 20rpx; margin-bottom: 10rpx;
  background: var(--card); border: 1rpx solid var(--line); border-radius: 14rpx;
}
.fz-item:last-of-type { margin-bottom: 0; }
.fz-name { font-size: 24rpx; color: var(--text); }
.fz-price { font-size: 24rpx; color: var(--primary-deep); font-weight: 700; }

.booster-scroll { white-space: nowrap; }
.booster-row { display: inline-flex; padding: 8rpx 4rpx 20rpx; }
.booster {
  flex: none; width: 300rpx;
  background: var(--card); border: 1rpx solid var(--line); border-radius: 28rpx;
  padding: 24rpx; margin-right: 20rpx;
}
.booster:active { transform: scale(.97); }
.booster .av {
  width: 88rpx; height: 88rpx; border-radius: 50%; overflow: hidden;
  border: 4rpx solid var(--primary); position: relative;
}
.booster .av .vip {
  position: absolute; bottom: -4rpx; right: -8rpx;
  font-size: 16rpx; background: var(--primary); color: #fff; border-radius: 8rpx; padding: 0 6rpx;
}
.booster .nm { font-size: 26rpx; font-weight: 700; margin-top: 16rpx; color: var(--text); }
.booster .meta { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.booster .price { margin-top: 16rpx; font-size: 28rpx; font-weight: 800; color: var(--primary-deep); }
.booster .price .small { font-size: 20rpx; color: var(--muted); font-weight: 400; }

/* ===== 护航列表 ===== */
.fbtn {
  flex: none; font-size: 24rpx; padding: 12rpx 28rpx; border-radius: 40rpx;
  border: 1rpx solid var(--line); color: var(--muted); background: var(--card); margin-right: 16rpx;
}
.fbtn.active {
  background: linear-gradient(135deg, #ff8a2a, var(--primary));
  color: #fff; border-color: transparent; font-weight: 600;
}
.bcard { display: flex; gap: 24rpx; padding: 28rpx; margin: 24rpx 24rpx 0; }
.bcard:active { transform: scale(.985); }
.bcard .av {
  width: 116rpx; height: 116rpx; border-radius: 50%; overflow: hidden;
  border: 4rpx solid var(--primary); flex: none; position: relative;
}
.bcard .av .lv {
  position: absolute; left: 50%; bottom: -6rpx; transform: translateX(-50%);
  background: var(--primary); color: #fff; font-size: 18rpx; padding: 0 12rpx; border-radius: 16rpx; white-space: nowrap;
}
.bcard .info { flex: 1; min-width: 0; }
.bcard .nm { display: flex; align-items: center; }
.bcard .nm .bn { font-size: 30rpx; font-weight: 700; color: var(--text); }
.bcard .row { display: flex; align-items: center; margin-top: 10rpx; flex-wrap: wrap; gap: 12rpx; }
.bcard .row .tag { margin-left: 0; }
.bcard .desc {
  font-size: 22rpx; color: var(--muted); margin-top: 12rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.bcard .rt { text-align: right; flex: none; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; }
.bcard .rt .p { color: var(--primary-deep); font-size: 32rpx; font-weight: 800; }
.bcard .rt .p .small { font-size: 20rpx; color: var(--muted); font-weight: 400; }
.bcard .rt .ord { font-size: 20rpx; color: var(--muted); }

/* ===== 下单详情 ===== */
.spec { margin: 24rpx; padding: 28rpx; }
.spec .lab { font-size: 24rpx; color: var(--muted); margin: 20rpx 0 16rpx; display: flex; align-items: center; }
.spec .lab::before { content: ""; width: 6rpx; height: 20rpx; background: var(--primary); border-radius: 4rpx; margin-right: 8rpx; }
.opts { display: flex; flex-wrap: wrap; }
.opt {
  font-size: 24rpx; padding: 14rpx 24rpx; border-radius: 16rpx;
  border: 1rpx solid var(--line); background: var(--card); color: var(--text);
  margin: 0 16rpx 16rpx 0; text-align: center;
}
.opt .sub { display: block; font-size: 20rpx; color: var(--muted); margin-top: 2rpx; }
.opt.active { border-color: var(--primary); color: var(--primary-hl); background: rgba(255,106,14,.08); font-weight: 600; }
.opt.active .sub { color: var(--primary-hl); }
.field { margin: 24rpx; display: flex; flex-direction: column; }
.field .row { display: flex; }
.field .row .inp {
  flex: 1; height: 88rpx;
  background: var(--card); border: 1rpx solid var(--line); border-radius: 16rpx;
  padding: 20rpx 24rpx; color: var(--text); font-size: 26rpx;
}
.field .row .inp + .inp { margin-left: 16rpx; }
.field .ta {
  width: 100%; height: 120rpx; margin-top: 16rpx;
  background: var(--card); border: 1rpx solid var(--line); border-radius: 16rpx;
  padding: 20rpx 24rpx; color: var(--text); font-size: 26rpx;
}
.order-bar {
  display: flex; align-items: center; gap: 24rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card); border-top: 1rpx solid var(--line);
}
.order-bar .total { font-size: 22rpx; color: var(--muted); }
.order-bar .total .tp { font-size: 36rpx; color: var(--primary-deep); }
.order-bar .total .tip { font-size: 20rpx; color: var(--muted); margin-top: 2rpx; }
.order-bar .btn { flex: 1; }

/* ===== 排行榜 ===== */
.rank-sel { display: flex; justify-content: center; padding: 24rpx; }
.rank-sel .fbtn { margin: 0 8rpx; }
.rank-list { padding: 0 24rpx; }
.r-item { display: flex; align-items: center; gap: 24rpx; padding: 24rpx; margin-bottom: 16rpx; }
.r-item .no { width: 44rpx; text-align: center; font-weight: 800; font-size: 30rpx; color: var(--muted); }
.r-item .no.n1 { color: #ff9f0a; }
.r-item .no.n2 { color: var(--muted2); }
.r-item .no.n3 { color: #e08a5c; }
.r-item .av { width: 80rpx; height: 80rpx; border-radius: 50%; overflow: hidden; border: 1rpx solid var(--line); }
.r-item .rmid { flex: 1; }
.r-item .nm { font-size: 26rpx; font-weight: 600; color: var(--text); }
.r-item .sub { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.r-item .val { text-align: right; }
.r-item .val .vv { color: var(--primary-deep); font-size: 28rpx; font-weight: 700; }

/* ===== 我的 ===== */
.me-head {
  margin: 24rpx; padding: 36rpx;
  display: flex; align-items: center; gap: 28rpx;
  background:
    radial-gradient(120% 180% at 100% 0%, rgba(255,150,70,.14), transparent 55%),
    linear-gradient(135deg, var(--warmB), var(--card));
  border: 1rpx solid var(--warmLine); border-radius: 32rpx; position: relative; overflow: hidden;
}
.me-head .av { width: 108rpx; height: 108rpx; border-radius: 50%; overflow: hidden; border: 4rpx solid var(--primary); }
.me-head .nm { display: flex; align-items: center; font-size: 34rpx; font-weight: 700; color: var(--text); }
.me-head .nm-edit { flex: none; margin-left: 14rpx; font-size: 20rpx; font-weight: 400; color: var(--primary-deep); padding: 4rpx 16rpx; border: 1rpx solid var(--warmLine); border-radius: 999rpx; }
.me-head .lv { font-size: 22rpx; color: var(--primary-deep); margin-top: 6rpx; }
.me-head .stats { margin-left: auto; display: flex; gap: 36rpx; position: relative; z-index: 1; }
.me-head .stats view { text-align: center; }
.me-head .stats .num { display: block; font-size: 32rpx; color: var(--primary-deep); }
.me-head .stats .cap { font-size: 20rpx; color: var(--muted); }

.orders { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin: 24rpx; }
.orders .o {
  background: var(--card); border: 1rpx solid var(--line); border-radius: 24rpx;
  padding: 24rpx 8rpx;
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  font-size: 22rpx; color: var(--muted);
}
.orders .o .num { font-size: 36rpx; font-weight: 700; color: var(--text); }

.mlist { background: var(--card); border: 1rpx solid var(--line); border-radius: 24rpx; margin: 24rpx; overflow: hidden; }
.mitem {
  display: flex; align-items: center; gap: 20rpx;
  padding: 26rpx 28rpx; font-size: 26rpx; color: var(--text);
  border-bottom: 1rpx solid var(--line);
}
.mitem:last-child { border-bottom: none; }
.mitem:active { background: var(--soft); }
.mitem .ic {
  width: 60rpx; height: 60rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}
.mitem .arr { margin-left: auto; color: var(--muted2); font-size: 22rpx; }

/* 钱包卡片 */
.wallet {
  margin: 0 24rpx; padding: 34rpx 36rpx; border-radius: 32rpx;
  position: relative; overflow: hidden; color: #fff;
  background:
    radial-gradient(120% 220% at 0% 0%, rgba(255,255,255,.20), transparent 55%),
    linear-gradient(135deg, #ff8a2a, #ff4d00);
}
.wallet .w-label { font-size: 24rpx; opacity: .92; }
.wallet .w-bal { display: block; font-size: 64rpx; font-weight: 800; margin-top: 10rpx; letter-spacing: 1rpx; }
.wallet .w-sym { font-size: 32rpx; font-weight: 600; margin-right: 8rpx; }
.wallet .w-acts { display: flex; gap: 16rpx; margin-top: 28rpx; }
.wallet .w-btn {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 20rpx;
  background: rgba(255,255,255,.22); color: #fff; font-size: 26rpx; font-weight: 600;
}
.wallet .w-btn:active { background: rgba(255,255,255,.34); }
.wallet .w-btn.hot { background: rgba(0,0,0,.18); }

/* ===== 弹窗 ===== */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(23,26,40,.55); z-index: 100;
  display: none; align-items: flex-end; justify-content: center;
}
.mask.show { display: flex; }
.mask.mid { align-items: center; }
.sheet {
  width: 100%; background: var(--card);
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  animation: up .25s ease;
}
@keyframes up { from { transform: translateY(60rpx); opacity: .4; } to { transform: none; opacity: 1; } }
.sheet .bar { width: 72rpx; height: 8rpx; border-radius: 4rpx; background: #e3e7ef; margin: 0 auto 28rpx; }
.sheet .sh-title { font-size: 30rpx; margin-bottom: 24rpx; color: var(--text); }
.sheet .btn { margin-top: 12rpx; }
.sheet .agree { text-align: center; font-size: 20rpx; color: var(--muted); margin-top: 20rpx; }

.pay-opt {
  display: flex; align-items: center; gap: 20rpx;
  padding: 26rpx; margin-bottom: 16rpx;
  border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--card);
}
.pay-opt.active { border-color: #2fd68b; background: rgba(47,214,139,.08); }
.pay-opt .ic {
  width: 60rpx; height: 60rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}
.pay-opt .pn { font-size: 26rpx; color: var(--text); }
.pay-opt .rr { margin-left: auto; color: #2fd68b; font-size: 28rpx; }

.ok-modal {
  width: 80%; background: var(--card); border-radius: 32rpx;
  padding: 52rpx 40rpx; text-align: center;
  animation: pop .25s ease;
}
@keyframes pop { from { transform: scale(.85); opacity: .4; } to { transform: none; opacity: 1; } }
.ok-modal .c {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: rgba(47,214,139,.15); color: #0f9d6e;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 28rpx; font-size: 60rpx;
}
.ok-modal .ok-h { font-size: 34rpx; margin-bottom: 16rpx; color: var(--text); }
.ok-modal .ok-p { font-size: 24rpx; color: var(--muted); line-height: 1.8; }
.ok-modal .ok-btns { display: flex; gap: 16rpx; margin-top: 36rpx; }
.ok-modal .ok-btns .btn { flex: 1; padding: 20rpx 0; }

/* ===== 通用表单弹窗（打手申请 / 修改昵称） ===== */
.apply-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.55);
  display: flex; align-items: center; justify-content: center;
  z-index: 99;
}
.apply-pop {
  width: 580rpx;
  max-height: 86vh;
  overflow-y: auto;
  background: var(--card);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
}
.apply-title { font-size: 32rpx; font-weight: 700; text-align: center; color: var(--text); }
.apply-tip { font-size: 22rpx; color: var(--muted); text-align: center; margin: 12rpx 0 28rpx; }
.apply-input {
  height: 84rpx; line-height: 84rpx;
  border: 1rpx solid var(--line); border-radius: 12rpx;
  padding: 0 24rpx; font-size: 27rpx; color: var(--text);
  background: var(--card);
  margin-bottom: 20rpx;
}
.apply-ta {
  width: 100%; box-sizing: border-box;
  min-height: 140rpx;
  border: 1rpx solid var(--line); border-radius: 12rpx;
  padding: 20rpx 24rpx; font-size: 27rpx; color: var(--text);
  background: var(--card);
  margin-bottom: 20rpx;
}
.apply-row2 { display: flex; gap: 16rpx; }
.apply-row2 .apply-input { flex: 1; }
.apply-ok {
  margin-top: 16rpx; text-align: center; padding: 18rpx 0;
  background: var(--primary); color: #fff; border-radius: 999rpx;
  font-size: 29rpx; font-weight: 600;
}
.apply-cancel {
  margin-top: 12rpx; text-align: center; padding: 14rpx 0;
  color: var(--muted); font-size: 25rpx;
}
/* 充值弹窗 */
.re-amounts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin: 8rpx 0 20rpx; }
.re-amt {
  padding: 20rpx 0; text-align: center; border-radius: 16rpx;
  border: 2rpx solid var(--line); font-size: 28rpx; color: var(--text); background: var(--card);
}
.re-amt.on { border-color: var(--primary); color: var(--primary-hl); background: rgba(255,106,14,.08); font-weight: 700; }
.re-custom { display: flex; align-items: center; gap: 20rpx; margin-bottom: 28rpx; font-size: 24rpx; color: var(--muted); }
.re-custom input { flex: 1; border: 1rpx solid var(--line); border-radius: 12rpx; padding: 16rpx 24rpx; font-size: 28rpx; color: var(--text); background: var(--card); }
